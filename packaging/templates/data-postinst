#!/bin/bash
# hermeswebui data package (deb-TarGz dual mode) lifecycle: install.
# The data package carries App Center metadata only (config.ini, app.lang,
# icon). It must not contain binaries (official one-vote-veto item,
# docs/official/deb-development-specification §Dual-Package Mode).
set -e

APP_HOME=/usr/local/hermeswebui

chmod 0644 "$APP_HOME/config.ini"
chmod 0644 "$APP_HOME/hermeswebui.lang"
chmod 0644 "$APP_HOME/images/icons/hermeswebui.svg"

exit 0
