[en-us]
name = "Hermes Agent"
auth = "Nous Research & nesquena"
descript = "Hermes Agent brings the open-source Hermes Agent to your TOS: chat from your browser with the same capabilities as the command line. Streaming replies, session and workspace browsing, profile switching, background operation, and scheduled tasks. Everything installs fully offline from the package. Conversations, memory, and settings stay on your device — nothing is uploaded to third parties. A first-run wizard helps you set an access password and connect your own model service (API key required)."
release_note = "Stable TOS 7 release. Installs fully offline: the Python runtime, Hermes Agent, and all dependencies ship inside the package. Opens from the App Center desktop icon in a new browser tab."
important = "Fully offline install — no internet access needed. Set an access password during onboarding. Conversations and API keys stay on your device; no data is collected or uploaded."

