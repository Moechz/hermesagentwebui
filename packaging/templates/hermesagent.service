[Unit]
Description=Hermes Agent WebUI for TOS 7
Documentation=https://github.com/Moechz/hermeswebui
After=network.target network-online.target
Wants=network-online.target
# First-start provisioning may outlast several restart attempts on slow
# networks (each retry resumes from the .part file); retry indefinitely so
# a temporarily unreachable component mirror self-heals.
StartLimitIntervalSec=0

[Service]
Type=simple
User=hermesagent
Group=hermesagent
WorkingDirectory=/usr/local/hermesagent
ExecStart=/usr/local/hermesagent/bin/hermesagent
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_WEBUI_HOST=0.0.0.0
Environment=HERMES_WEBUI_PORT=8787
Environment=HERMES_HOME=/var/lib/hermesagent/hermes
Environment=HERMES_WEBUI_STATE_DIR=/var/lib/hermesagent/hermes/webui
# Runtime lazy-installs (agent optional features, e.g. image-gen extras)
# inherit these: TUNA primary keeps turns from stalling on slow pypi.org
# routes (same mirror choice as the bootstrap agent-deps install, D-010).
Environment=PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
Environment=UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
TimeoutStartSec=60
TimeoutStopSec=15
KillMode=control-group
# First-start provisioning depends on network that may not be ready at
# boot; retry with backoff so the bootstrap self-heals (bounded by
# StartLimit* above; a hard failure stays failed for manual attention).
Restart=on-failure
RestartSec=10s
LimitNOFILE=65535

# systemd creates /var/lib/hermesagent and /var/log/hermesagent and grants
# write access despite ProtectSystem=strict (StateDirectory/LogsDirectory
# are implicitly added to the writable set).
StateDirectory=hermesagent
StateDirectoryMode=0711
LogsDirectory=hermesagent
LogsDirectoryMode=0750

# The portable runtime and the single application venv (webui wheels +
# agent deps + editable agent source) live under /var/lib/hermesagent
# (StateDirectory is implicitly writable despite ProtectSystem=strict). User
# workspaces may live on TOS volumes (Volume1/Volume2..., "-" tolerates absence).
ReadWritePaths=-/Volume1 -/Volume2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# MemoryDenyWriteExecute is intentionally NOT set: CPython and the Hermes
# Agent's native/ML dependencies require writable+executable memory mappings.

[Install]
WantedBy=multi-user.target
