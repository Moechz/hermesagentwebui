#!/bin/sh
# hermesagent service launcher (staged as /usr/local/hermesagent/bin/hermesagent).
#
# First start: the bootstrap (running on the TOS system Python) provisions the
# portable CPython runtime, the agent source and the app venv entirely from
# the payload and wheels bundled inside the deb (offline, D-015/S8: no
# online installation anywhere in the package). Later starts take the fast
# path.
set -eu

APP_HOME=/usr/local/hermesagent
STATE=/var/lib/hermesagent
BOOTSTRAP="$APP_HOME/bin/hermesagent-bootstrap"
PROVISION="$APP_HOME/bin/hermesagent-provision"
BOOTLOG="$STATE/bootstrap/last.log"
SYSTEM_PYTHON=/usr/bin/python3
WEBUI_PYTHON="$STATE/venvs/app/bin/python3"
APP_ENTRY="$APP_HOME/app/server.py"

# Bind all interfaces so the TOS desktop External Open entry (client-side,
# opens http://${ip}:8787 in a new browser tab, D-011) can reach the app
# from LAN clients. Access control is the WebUI password set during
# first-run onboarding (REQUIREMENTS 5.1, upstream F-10). Residual risk
# tracked in docs/TASK_STATE.md.
export HERMES_WEBUI_HOST="${HERMES_WEBUI_HOST:-0.0.0.0}"
export HERMES_WEBUI_PORT="${HERMES_WEBUI_PORT:-8787}"
export HERMES_HOME="${HERMES_HOME:-$STATE/hermes}"
export HERMES_WEBUI_STATE_DIR="${HERMES_WEBUI_STATE_DIR:-$HERMES_HOME/webui}"
export HERMES_WEBUI_AGENT_DIR="${HERMES_WEBUI_AGENT_DIR:-$STATE/hermes/hermes-agent}"
export PYTHONUNBUFFERED=1

if ! "$SYSTEM_PYTHON" "$BOOTSTRAP" --check >/dev/null 2>&1; then
  # First-start provisioning. A stdlib-only placeholder page binds the
  # port while components are assembled locally from the deb payload
  # (1-3 minutes, offline), so users see live progress instead of
  # "connection refused" (user-reported confusion; D-013). Bootstrap
  # output also lands in bootstrap/last.log for the placeholder and for
  # post-hoc debugging (TOS user accounts often cannot read the systemd
  # journal).
  mkdir -p "$STATE/bootstrap"
  "$SYSTEM_PYTHON" "$PROVISION" &
  PROV_PID=$!
  if "$SYSTEM_PYTHON" "$BOOTSTRAP" >"$BOOTLOG" 2>&1; then
    cat "$BOOTLOG" || true
  else
    cat "$BOOTLOG" || true
    echo "hermesagent: first-start provisioning failed; systemd will retry (Restart=on-failure)" >&2
    kill "$PROV_PID" 2>/dev/null || true
    wait "$PROV_PID" 2>/dev/null || true
    exit 1
  fi
  kill "$PROV_PID" 2>/dev/null || true
  wait "$PROV_PID" 2>/dev/null || true
fi

exec "$WEBUI_PYTHON" "$APP_ENTRY"
