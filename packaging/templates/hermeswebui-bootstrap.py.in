#!/usr/bin/env python3
"""hermeswebui first-start bootstrap (D-007/D-010).

Runs on the TOS system Python (3.10, stdlib only) before the WebUI starts:

  1. read the pinned component manifest shipped inside the deb
  2. fetch the portable CPython runtime and the Hermes Agent source from
     the application's own GitHub Release (single whitelisted origin),
     verifying size and SHA-256 for every artifact; downloads are
     Range-resumable — a partial .part from a killed or timed-out attempt
     (same run or a later service restart) continues from its byte offset
     instead of restarting from zero
  3. unpack with hardened tar handling (no absolute paths, no traversal,
     no symlink escape, no device nodes)
  4. create the single application venv (upstream's server imports the
     agent in-process, so one interpreter serves both):
       - webui wheels from the deb (offline, no network)
       - agent locked dependencies via pip --require-hashes
         (TUNA primary, PyPI fallback — identical hashes)
       - the agent source itself as an editable install (upstream's
         setup.py only supports editable installs)
  5. converge provisioned state to the deb's pins: every service start
     diffs state.json against the in-deb manifest + lock fingerprints
     and re-provisions exactly the sections whose pins changed (D-014
     — device upgrades need no manual wiping). HERMES_HOME user data
     (sessions, memory, credentials) is never touched. Any failure
     exits non-zero with a readable message; the systemd unit's restart
     policy drives retries. No silent degradation, ever.

Security invariants:
  - downloads only from https://github.com (manifest release_base prefix)
  - a manifest with a null/missing hash is refused outright
  - tar members are individually validated before extraction
  - subprocess calls are argv arrays only; no shell strings
"""
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request

APP_HOME = os.environ.get("HWUI_APP_HOME", "/usr/local/hermeswebui")
STATE = os.environ.get("HWUI_STATE", "/var/lib/hermeswebui")
ALLOWED_HOST = "github.com"
CHUNK = 1024 * 1024
# In-process attempts per download; after the last one the bootstrap fails
# and systemd's Restart=on-failure (unlimited, D-013) reruns it — resuming
# from the kept .part file. Retries inside one run avoid a full unit
# restart per network hiccup.
DOWNLOAD_ATTEMPTS = 3
RETRY_WAIT_S = 5  # backoff between attempts, multiplied by attempt number


class BootError(Exception):
    pass


def log(msg: str) -> None:
    print(f"hermeswebui-bootstrap: {msg}", file=sys.stderr, flush=True)


def load_manifest() -> dict:
    path = os.path.join(APP_HOME, "manifests", "components.json")
    try:
        with open(path, encoding="utf-8") as f:
            m = json.load(f)
    except (OSError, ValueError) as e:
        raise BootError(f"cannot read manifest {path}: {e}")
    if m.get("schema") != 1:
        raise BootError(f"unsupported manifest schema: {m.get('schema')!r}")
    for section in ("runtime", "agent"):
        comp = m.get(section, {})
        for field in ("file", "sha256", "size", "dest"):
            if comp.get(field) in (None, ""):
                raise BootError(f"manifest {section}.{field} missing — refusing to fetch")
    return m


def component_url(manifest: dict, section: str) -> str:
    base = manifest["release_base"].rstrip("/")
    url = f"{base}/{manifest[section]['file']}"
    if not url.startswith("https://" + ALLOWED_HOST + "/"):
        raise BootError(f"url outside whitelist: {url}")
    return url


def file_sha256(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(CHUNK), b""):
            h.update(chunk)
    return h.hexdigest()


def download(url: str, dest: str, sha256: str, size: int) -> None:
    """Fetch url -> dest with size + SHA-256 verification and resume.

    Integrity is always decided by a hash over the FULL file, so a corrupt
    or tampered prefix can only ever fail verification, never pass it. An
    incomplete .part is kept across attempts and service restarts and
    resumed via `Range: bytes=N-`; a server that ignores Range (200 full
    body, or a Content-Range that does not start at N) forces a clean
    restart. A .part that already reached the pinned size is verified and
    adopted without touching the network.
    """
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    # Fast path: an already-present file with the pinned size and hash
    # (pre-seeded, or left by an earlier run that failed at a later step)
    # is used as-is; never re-download verified bytes.
    if os.path.exists(dest) and os.path.getsize(dest) == size \
            and file_sha256(dest) == sha256:
        log(f"using verified local file {os.path.basename(dest)}")
        return
    tmp = dest + ".part"
    for attempt in range(1, DOWNLOAD_ATTEMPTS + 1):
        try:
            _download_attempt(url, tmp, size)
            break
        except (OSError, urllib.error.URLError) as e:
            if attempt == DOWNLOAD_ATTEMPTS:
                raise BootError(
                    f"download failed {url} after {attempt} attempts; "
                    f"keeping {os.path.basename(tmp)} so the next service "
                    f"restart resumes it: {e}")
            wait = RETRY_WAIT_S * attempt
            log(f"download attempt {attempt} failed ({e}); "
                f"resuming in {wait}s ...")
            time.sleep(wait)
    # _download_attempt only returns on a complete transfer (or a complete
    # pre-existing .part); the hash now decides adoption or a clean re-fetch.
    digest = file_sha256(tmp)
    if digest != sha256:
        os.remove(tmp)
        raise BootError(f"{url}: sha256 mismatch got {digest} expected "
                        f"{sha256} — discarded partial file")
    os.replace(tmp, dest)


def _download_attempt(url: str, tmp: str, size: int) -> None:
    """One download pass over tmp; raise OSError/URLError to request a retry."""
    start = 0
    if os.path.exists(tmp):
        if os.path.getsize(tmp) > size:
            os.remove(tmp)  # foreign/corrupt prefix; start clean
        else:
            start = os.path.getsize(tmp)
    if start == size:
        return  # complete prefix from an earlier attempt; caller verifies
    headers = {"Range": f"bytes={start}-"} if start else {}
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=60) as resp:
        resume = False
        if start:
            # 206 + a Content-Range rooted at our offset confirm the server
            # honored the resume; anything else restarts from byte zero.
            content_range = resp.headers.get("Content-Range", "")
            resume = getattr(resp, "status", 200) == 206 \
                and content_range.startswith(f"bytes {start}-")
            if resume:
                log(f"resuming {os.path.basename(tmp)} at byte {start} "
                    f"of {size}")
            else:
                start = 0
        with open(tmp, "ab" if resume else "wb") as out:
            while True:
                chunk = resp.read(CHUNK)
                if not chunk:
                    break
                start += len(chunk)
                if start > size:
                    raise OSError(f"body exceeds expected size {size}")
                out.write(chunk)
    if start != size:
        raise OSError(f"incomplete body: got {start} of {size}")


def _safe_target(dest_root: str, name: str, strip: int):
    parts = name.split("/")
    if strip:
        parts = parts[strip:]
    # The archive's own root entry (e.g. "name" or "name/") is consumed
    # entirely by strip; it is not an escape, just skip it.
    if not parts or parts == [""]:
        return None
    if name.startswith("/") or ".." in parts:
        raise BootError(f"unsafe tar member: {name}")
    return os.path.join(dest_root, *parts)


def safe_extract(tar_path: str, dest_root: str, strip: int = 0) -> None:
    os.makedirs(dest_root, exist_ok=True)
    root_real = os.path.realpath(dest_root)
    with tarfile.open(tar_path, "r:gz") as tf:
        for member in tf:
            target = _safe_target(dest_root, member.name, strip)
            if target is None:
                continue
            real_parent = os.path.realpath(os.path.dirname(target))
            if not real_parent.startswith(root_real + os.sep) and real_parent != root_real:
                raise BootError(f"tar member escapes destination: {member.name}")
            if member.issym() or member.islnk():
                link = member.linkname or ""
                if link.startswith("/"):
                    raise BootError(f"absolute link in archive: {member.name}")
                os.makedirs(real_parent, exist_ok=True)
                try:
                    os.symlink(link, target)
                except FileExistsError:
                    pass
            elif member.isdir():
                os.makedirs(target, exist_ok=True)
            elif member.isfile():
                os.makedirs(real_parent, exist_ok=True)
                src = tf.extractfile(member)
                if src is None:
                    raise BootError(f"cannot extract member: {member.name}")
                with open(target, "wb") as out:
                    shutil.copyfileobj(src, out)
                os.chmod(target, (member.mode & 0o777) or 0o644)
            else:
                raise BootError(f"unsupported tar member type: {member.name}")


class State:
    def __init__(self, path: str):
        self.path = path
        try:
            with open(path, encoding="utf-8") as f:
                self.data = json.load(f)
        except (OSError, ValueError):
            self.data = {}

    def done(self, key: str) -> bool:
        return bool(self.data.get(key, {}).get("ok"))

    def mark(self, key: str, **kv) -> None:
        self.data.setdefault(key, {})
        self.data[key].update({"ok": True}, **kv)
        tmp = self.path + ".tmp"
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.data, f, indent=2)
        os.replace(tmp, self.path)


def run(argv, **kw) -> subprocess.CompletedProcess:
    log("run: " + " ".join(argv))
    return subprocess.run(argv, **kw)


def _file_fingerprint(path: str) -> str:
    try:
        return file_sha256(path)
    except OSError:
        return "-"


def deb_fingerprints() -> dict:
    """SHA-256 fingerprints of the lock files shipped inside the deb.

    A new deb that changes any of them (or the manifest pins) makes the
    next service start re-provision exactly the affected sections
    (D-014). Hashing a lock file is milliseconds, so --check on every
    start stays fast.
    """
    return {
        "wheels_req": _file_fingerprint(
            os.path.join(APP_HOME, "wheels", "requirements.txt")),
        "agent_core_req": _file_fingerprint(
            os.path.join(APP_HOME, "agent", "agent-core-requirements.txt")),
        "lazy_extras": _file_fingerprint(
            os.path.join(APP_HOME, "agent", "lazy-extras.lock")),
    }


def plan_sections(m: dict, st: State, fp: dict) -> list:
    """Diff provisioned state against the deb's pins (D-014).

    Returns sections needing (re-)provisioning, in execution order. The
    deb's manifest and lock fingerprints are authoritative; a changed
    pin re-provisions that section plus everything whose artifacts it
    destroys (a recreated venv wipes installed deps and the editable
    install; a replaced agent tree invalidates the editable install).
    HERMES_HOME user data is never touched.
    """
    rt_sha = m["runtime"]["sha256"]
    ag_sha = m["agent"]["sha256"]
    todo = []
    rt_rec = st.data.get("runtime", {})
    rt_py = os.path.join(STATE, m["runtime"]["dest"], "bin", "python3")
    if not (st.done("runtime") and rt_rec.get("sha256") == rt_sha
            and os.path.exists(rt_py)):
        if st.done("runtime"):
            log(f"runtime pin changed ({rt_rec.get('sha256', '-')[:12]}… "
                f"-> {rt_sha[:12]}…): re-provisioning")
        todo.append("runtime")
    venv_rec = st.data.get("app_venv", {})
    pip_bin = os.path.join(STATE, "venvs", "app", "bin", "pip")
    if not (st.done("app_venv")
            and "runtime" not in todo
            and venv_rec.get("runtime_sha") == rt_sha
            and venv_rec.get("wheels_sha") == fp["wheels_req"]
            and os.path.exists(pip_bin)):
        if st.done("app_venv"):
            log("app venv outdated (runtime or webui wheels changed): "
                "recreating")
        todo.append("app_venv")
    ag_rec = st.data.get("agent_src", {})
    ag_dir = os.path.join(STATE, m["agent"]["dest"])
    if not (st.done("agent_src") and ag_rec.get("sha256") == ag_sha
            and os.path.isdir(ag_dir)):
        if st.done("agent_src"):
            log(f"agent pin changed ({ag_rec.get('sha256', '-')[:12]}… "
                f"-> {ag_sha[:12]}…): re-provisioning")
        todo.append("agent_src")
    deps_rec = st.data.get("agent_deps", {})
    # Deps live in the venv, not in the agent source tree — an agent-only
    # change does NOT reinstall them; only a venv recreation does.
    if not (st.done("agent_deps")
            and "app_venv" not in todo
            and deps_rec.get("req_sha") == fp["agent_core_req"]):
        if st.done("agent_deps"):
            log("agent dependencies lock changed (or venv recreated): "
                "reinstalling")
        todo.append("agent_deps")
    extras_rec = st.data.get("lazy_extras", {})
    if not (st.done("lazy_extras")
            and "app_venv" not in todo
            and extras_rec.get("req_sha") == fp["lazy_extras"]):
        if st.done("lazy_extras"):
            log("lazy extras lock changed (or venv recreated): reinstalling")
        todo.append("lazy_extras")
    # The editable install (pth + PEP660 finder) points into the agent
    # source tree and lives in the venv — redo it when either changes;
    # dependency-package changes alone do not affect it.
    if not (st.done("agent_editable")
            and "app_venv" not in todo and "agent_src" not in todo):
        if st.done("agent_editable"):
            log("agent source or venv changed: reinstalling editable")
        todo.append("agent_editable")
    return todo


def ensure_runtime(m: dict, st: State, downloads: str) -> str:
    dest = os.path.join(STATE, m["runtime"]["dest"])
    rt_sha = m["runtime"]["sha256"]
    log(f"provisioning portable CPython {m['runtime']['python']} ...")
    tarball = os.path.join(downloads, m["runtime"]["file"])
    download(component_url(m, "runtime"), tarball, rt_sha, int(m["runtime"]["size"]))
    tmp_root = tempfile.mkdtemp(prefix="hwui-rt-", dir=STATE)
    try:
        # PBS install_only tarballs unpack to a single top-level python/ dir.
        safe_extract(tarball, tmp_root)
        src = os.path.join(tmp_root, "python")
        if not os.path.exists(os.path.join(src, "bin", "python3")):
            raise BootError("runtime archive did not contain python/bin/python3")
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if os.path.exists(dest):
            shutil.rmtree(dest)
        os.replace(src, dest)
    finally:
        shutil.rmtree(tmp_root, ignore_errors=True)
    os.remove(tarball)
    st.mark("runtime", sha256=rt_sha)
    return os.path.join(dest, "bin", "python3")


def ensure_app_venv(m: dict, rt_python: str, st: State, fp: dict) -> str:
    """(Re)create the single application venv and install the offline wheels.

    Upstream's server imports run_agent.AIAgent in-process
    (api/agent_runtime.py), so the webui server and the agent share ONE
    interpreter environment: webui wheels + agent locked deps + editable
    agent source all live in $STATE/venvs/app.
    """
    venv = os.path.join(STATE, "venvs", "app")
    log("creating app venv (offline wheels) ...")
    if os.path.exists(venv):
        # Recreate clean: stale site-packages and __editable__ finders
        # from a previous provisioning must not leak into the new one.
        shutil.rmtree(venv)
    r = run([rt_python, "-m", "venv", venv], capture_output=True, text=True)
    if r.returncode != 0:
        raise BootError(f"venv creation failed: {r.stderr.strip()}")
    pip = os.path.join(venv, "bin", "pip")
    req = os.path.join(APP_HOME, "wheels", "requirements.txt")
    r = run([pip, "install", "--no-index", "--find-links",
             os.path.join(APP_HOME, "wheels"), "-r", req],
            capture_output=True, text=True)
    if r.returncode != 0:
        raise BootError(f"webui wheels install failed: {r.stderr.strip()[-2000:]}")
    st.mark("app_venv", runtime_sha=m["runtime"]["sha256"],
            wheels_sha=fp["wheels_req"])
    return os.path.join(venv, "bin", "python3")


def ensure_agent(m: dict, st: State, downloads: str) -> str:
    dest = os.path.join(STATE, m["agent"]["dest"])
    ag_sha = m["agent"]["sha256"]
    log(f"provisioning hermes-agent {m['agent']['version']} source ...")
    tarball = os.path.join(downloads, m["agent"]["file"])
    download(component_url(m, "agent"), tarball, ag_sha, int(m["agent"]["size"]))
    tmp_root = tempfile.mkdtemp(prefix="hwui-ag-", dir=STATE)
    try:
        safe_extract(tarball, tmp_root, strip=1)
        if os.path.exists(dest):
            shutil.rmtree(dest)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        os.replace(tmp_root, dest)
        tmp_root = None
    finally:
        if tmp_root:
            shutil.rmtree(tmp_root, ignore_errors=True)
    os.remove(tarball)
    st.mark("agent_src", sha256=ag_sha)
    return dest


def install_with_fallback(pip: str, args: list, indexes: list) -> None:
    """pip install with index fallback; hashes stay identical on mirrors."""
    last = ""
    for idx in indexes:
        r = run([pip, "install", "--index-url", idx, *args],
                capture_output=True, text=True)
        if r.returncode == 0:
            return
        last = r.stderr.strip()[-2000:]
        log(f"index {idx} failed, trying fallback ...")
    raise BootError(f"pip install failed: {last}")


def ensure_agent_deps(m: dict, st: State, fp: dict) -> None:
    pip = os.path.join(STATE, "venvs", "app", "bin", "pip")
    log("installing agent locked dependencies (hashed) ...")
    req = os.path.join(APP_HOME, "agent", "agent-core-requirements.txt")
    install_with_fallback(pip, ["--require-hashes", "-r", req],
                          [m["pip"]["index_url"], m["pip"]["fallback_index_url"]])
    st.mark("agent_deps", req_sha=fp["agent_core_req"])


def ensure_lazy_extras(m: dict, st: State, fp: dict) -> None:
    """Pre-install the agent's runtime lazy-install extras (tts.edge etc.).

    The agent's tool registry lazily pip-installs optional feature deps on
    first use; on a slow network that stalls the first chat turn by minutes
    (user-observed: 98s for edge-tts). Pre-installing the hashed union lock
    (agent-core + extras, versions unified) removes the stall. Non-fatal:
    TTS is optional, the agent falls back to lazy install at runtime."""
    mark = "lazy_extras"
    pip = os.path.join(STATE, "venvs", "app", "bin", "pip")
    req = os.path.join(APP_HOME, "agent", "lazy-extras.lock")
    if not os.path.exists(req):
        log("lazy-extras lock missing, skipping (runtime lazy install remains)")
        st.mark(mark, req_sha=fp["lazy_extras"])
        return
    log("installing lazy extras: edge-tts (hashed) ...")
    try:
        install_with_fallback(pip, ["--require-hashes", "-r", req],
                              [m["pip"]["index_url"], m["pip"]["fallback_index_url"]])
        st.mark(mark, req_sha=fp["lazy_extras"])
    except BootError as e:
        log(f"WARNING: lazy extras install failed (optional; will retry next "
            f"start, runtime lazy install remains): {e}")


def ensure_agent_editable(m: dict, agent_dir: str, st: State) -> None:
    pip = os.path.join(STATE, "venvs", "app", "bin", "pip")
    log("installing hermes-agent (editable) ...")
    # hermes-agent's setup.py refuses regular wheel/sdist builds by design
    # (upstream distributes via installer/Docker/Nix); editable install is
    # the supported path and keeps the unpacked source tree authoritative.
    # Build isolation needs setuptools+wheel from an index, so the index
    # (with fallback) is passed here too.
    install_with_fallback(pip, ["--no-deps", "--editable", agent_dir],
                          [m["pip"]["index_url"], m["pip"]["fallback_index_url"]])
    st.mark("agent_editable")


def check(m: dict, st: State) -> bool:
    """True only when every section is provisioned AND current vs pins."""
    return not plan_sections(m, st, deb_fingerprints())


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true",
                    help="exit 0 only if every component is provisioned "
                         "and matches the deb's pinned versions")
    args = ap.parse_args()
    try:
        m = load_manifest()
        st = State(os.path.join(STATE, "bootstrap", "state.json"))
        fp = deb_fingerprints()
        if args.check:
            return 0 if check(m, st) else 1
        todo = plan_sections(m, st, fp)
        if not todo:
            log("all components provisioned and current")
            return 0
        downloads = os.path.join(STATE, "downloads")
        os.makedirs(downloads, exist_ok=True)
        if "runtime" in todo:
            rt_python = ensure_runtime(m, st, downloads)
        else:
            rt_python = os.path.join(STATE, m["runtime"]["dest"], "bin", "python3")
        if "app_venv" in todo:
            rt_python = ensure_app_venv(m, rt_python, st, fp)
        if "agent_src" in todo:
            agent_dir = ensure_agent(m, st, downloads)
        else:
            agent_dir = os.path.join(STATE, m["agent"]["dest"])
        if "agent_deps" in todo:
            ensure_agent_deps(m, st, fp)
        if "lazy_extras" in todo:
            ensure_lazy_extras(m, st, fp)
        if "agent_editable" in todo:
            ensure_agent_editable(m, agent_dir, st)
        log("all components provisioned")
        return 0
    except BootError as e:
        log(str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main())
