#!/usr/bin/env python3
"""hermeswebui first-start bootstrap (D-007/D-010).

Runs on the TOS system Python (3.10, stdlib only) before the WebUI starts:

  1. read the pinned component manifest shipped inside the deb
  2. fetch the portable CPython runtime and the Hermes Agent source from
     the application's own GitHub Release (single whitelisted origin),
     verifying size and SHA-256 for every artifact
  3. unpack with hardened tar handling (no absolute paths, no traversal,
     no symlink escape, no device nodes)
  4. create the single application venv (upstream's server imports the
     agent in-process, so one interpreter serves both):
       - webui wheels from the deb (offline, no network)
       - agent locked dependencies via pip --require-hashes
         (TUNA primary, PyPI fallback — identical hashes)
       - the agent source itself as an editable install (upstream's
         setup.py only supports editable installs)
  5. record progress in a state file; every step is idempotent and safe to
     retry. Any failure exits non-zero with a readable message; the systemd
     unit's restart policy drives retries. No silent degradation, ever.

Security invariants:
  - downloads only from https://github.com (manifest release_base prefix)
  - a manifest with a null/missing hash is refused outright
  - tar members are individually validated before extraction
  - subprocess calls are argv arrays only; no shell strings
"""
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request

APP_HOME = os.environ.get("HWUI_APP_HOME", "/usr/local/hermeswebui")
STATE = os.environ.get("HWUI_STATE", "/var/lib/hermeswebui")
ALLOWED_HOST = "github.com"
CHUNK = 1024 * 1024


class BootError(Exception):
    pass


def log(msg: str) -> None:
    print(f"hermeswebui-bootstrap: {msg}", file=sys.stderr, flush=True)


def load_manifest() -> dict:
    path = os.path.join(APP_HOME, "manifests", "components.json")
    try:
        with open(path, encoding="utf-8") as f:
            m = json.load(f)
    except (OSError, ValueError) as e:
        raise BootError(f"cannot read manifest {path}: {e}")
    if m.get("schema") != 1:
        raise BootError(f"unsupported manifest schema: {m.get('schema')!r}")
    for section in ("runtime", "agent"):
        comp = m.get(section, {})
        for field in ("file", "sha256", "size", "dest"):
            if comp.get(field) in (None, ""):
                raise BootError(f"manifest {section}.{field} missing — refusing to fetch")
    return m


def component_url(manifest: dict, section: str) -> str:
    base = manifest["release_base"].rstrip("/")
    url = f"{base}/{manifest[section]['file']}"
    if not url.startswith("https://" + ALLOWED_HOST + "/"):
        raise BootError(f"url outside whitelist: {url}")
    return url


def download(url: str, dest: str, sha256: str, size: int) -> None:
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    # Fast path: an already-present file with the pinned size and hash
    # (pre-seeded, or left by an earlier run that failed at a later step)
    # is used as-is; never re-download verified bytes.
    if os.path.exists(dest) and os.path.getsize(dest) == size:
        h = hashlib.sha256()
        with open(dest, "rb") as f:
            for chunk in iter(lambda: f.read(CHUNK), b""):
                h.update(chunk)
        if h.hexdigest() == sha256:
            log(f"using verified local file {os.path.basename(dest)}")
            return
    tmp = dest + ".part"
    h = hashlib.sha256()
    got = 0
    try:
        with urllib.request.urlopen(url, timeout=60) as resp, open(tmp, "wb") as out:
            while True:
                chunk = resp.read(CHUNK)
                if not chunk:
                    break
                got += len(chunk)
                if got > size:
                    raise BootError(f"{url}: exceeds expected size {size}")
                h.update(chunk)
                out.write(chunk)
    except (OSError, urllib.error.URLError) as e:
        raise BootError(f"download failed {url}: {e}")
    if got != size:
        raise BootError(f"{url}: size mismatch got {got} expected {size}")
    if h.hexdigest() != sha256:
        raise BootError(f"{url}: sha256 mismatch got {h.hexdigest()} expected {sha256}")
    os.replace(tmp, dest)


def _safe_target(dest_root: str, name: str, strip: int):
    parts = name.split("/")
    if strip:
        parts = parts[strip:]
    # The archive's own root entry (e.g. "name" or "name/") is consumed
    # entirely by strip; it is not an escape, just skip it.
    if not parts or parts == [""]:
        return None
    if name.startswith("/") or ".." in parts:
        raise BootError(f"unsafe tar member: {name}")
    return os.path.join(dest_root, *parts)


def safe_extract(tar_path: str, dest_root: str, strip: int = 0) -> None:
    os.makedirs(dest_root, exist_ok=True)
    root_real = os.path.realpath(dest_root)
    with tarfile.open(tar_path, "r:gz") as tf:
        for member in tf:
            target = _safe_target(dest_root, member.name, strip)
            if target is None:
                continue
            real_parent = os.path.realpath(os.path.dirname(target))
            if not real_parent.startswith(root_real + os.sep) and real_parent != root_real:
                raise BootError(f"tar member escapes destination: {member.name}")
            if member.issym() or member.islnk():
                link = member.linkname or ""
                if link.startswith("/"):
                    raise BootError(f"absolute link in archive: {member.name}")
                os.makedirs(real_parent, exist_ok=True)
                try:
                    os.symlink(link, target)
                except FileExistsError:
                    pass
            elif member.isdir():
                os.makedirs(target, exist_ok=True)
            elif member.isfile():
                os.makedirs(real_parent, exist_ok=True)
                src = tf.extractfile(member)
                if src is None:
                    raise BootError(f"cannot extract member: {member.name}")
                with open(target, "wb") as out:
                    shutil.copyfileobj(src, out)
                os.chmod(target, (member.mode & 0o777) or 0o644)
            else:
                raise BootError(f"unsupported tar member type: {member.name}")


class State:
    def __init__(self, path: str):
        self.path = path
        try:
            with open(path, encoding="utf-8") as f:
                self.data = json.load(f)
        except (OSError, ValueError):
            self.data = {}

    def done(self, key: str) -> bool:
        return bool(self.data.get(key, {}).get("ok"))

    def mark(self, key: str, **kv) -> None:
        self.data.setdefault(key, {})
        self.data[key].update({"ok": True}, **kv)
        tmp = self.path + ".tmp"
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.data, f, indent=2)
        os.replace(tmp, self.path)


def run(argv, **kw) -> subprocess.CompletedProcess:
    log("run: " + " ".join(argv))
    return subprocess.run(argv, **kw)


def ensure_runtime(m: dict, st: State, downloads: str) -> str:
    dest = os.path.join(STATE, m["runtime"]["dest"])
    rt_sha = m["runtime"]["sha256"]
    if st.done("runtime") and os.path.exists(os.path.join(dest, "bin", "python3")):
        return os.path.join(dest, "bin", "python3")
    log(f"provisioning portable CPython {m['runtime']['python']} ...")
    tarball = os.path.join(downloads, m["runtime"]["file"])
    download(component_url(m, "runtime"), tarball, rt_sha, int(m["runtime"]["size"]))
    tmp_root = tempfile.mkdtemp(prefix="hwui-rt-", dir=STATE)
    try:
        # PBS install_only tarballs unpack to a single top-level python/ dir.
        safe_extract(tarball, tmp_root)
        src = os.path.join(tmp_root, "python")
        if not os.path.exists(os.path.join(src, "bin", "python3")):
            raise BootError("runtime archive did not contain python/bin/python3")
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if os.path.exists(dest):
            shutil.rmtree(dest)
        os.replace(src, dest)
    finally:
        shutil.rmtree(tmp_root, ignore_errors=True)
    os.remove(tarball)
    st.mark("runtime", sha256=rt_sha)
    return os.path.join(dest, "bin", "python3")


def ensure_app_venv(rt_python: str, st: State) -> str:
    """Create the single application venv and install the offline wheels.

    Upstream's server imports run_agent.AIAgent in-process
    (api/agent_runtime.py), so the webui server and the agent share ONE
    interpreter environment: webui wheels + agent locked deps + editable
    agent source all live in $STATE/venvs/app.
    """
    venv = os.path.join(STATE, "venvs", "app")
    pip = os.path.join(venv, "bin", "pip")
    if st.done("app_venv") and os.path.exists(pip):
        return os.path.join(venv, "bin", "python3")
    log("creating app venv (offline wheels) ...")
    r = run([rt_python, "-m", "venv", venv], capture_output=True, text=True)
    if r.returncode != 0:
        raise BootError(f"venv creation failed: {r.stderr.strip()}")
    req = os.path.join(APP_HOME, "wheels", "requirements.txt")
    r = run([pip, "install", "--no-index", "--find-links",
             os.path.join(APP_HOME, "wheels"), "-r", req],
            capture_output=True, text=True)
    if r.returncode != 0:
        raise BootError(f"webui wheels install failed: {r.stderr.strip()[-2000:]}")
    st.mark("app_venv")
    return os.path.join(venv, "bin", "python3")


def ensure_agent(m: dict, st: State, downloads: str) -> str:
    dest = os.path.join(STATE, m["agent"]["dest"])
    ag_sha = m["agent"]["sha256"]
    if st.done("agent_src") and os.path.isdir(dest):
        return dest
    log(f"provisioning hermes-agent {m['agent']['version']} source ...")
    tarball = os.path.join(downloads, m["agent"]["file"])
    download(component_url(m, "agent"), tarball, ag_sha, int(m["agent"]["size"]))
    tmp_root = tempfile.mkdtemp(prefix="hwui-ag-", dir=STATE)
    try:
        safe_extract(tarball, tmp_root, strip=1)
        if os.path.exists(dest):
            shutil.rmtree(dest)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        os.replace(tmp_root, dest)
        tmp_root = None
    finally:
        if tmp_root:
            shutil.rmtree(tmp_root, ignore_errors=True)
    os.remove(tarball)
    st.mark("agent_src", sha256=ag_sha)
    return dest


def install_with_fallback(pip: str, args: list, indexes: list) -> None:
    """pip install with index fallback; hashes stay identical on mirrors."""
    last = ""
    for idx in indexes:
        r = run([pip, "install", "--index-url", idx, *args],
                capture_output=True, text=True)
        if r.returncode == 0:
            return
        last = r.stderr.strip()[-2000:]
        log(f"index {idx} failed, trying fallback ...")
    raise BootError(f"pip install failed: {last}")


def ensure_agent_deps(m: dict, st: State) -> None:
    if st.done("agent_deps"):
        return
    pip = os.path.join(STATE, "venvs", "app", "bin", "pip")
    log("installing agent locked dependencies (hashed) ...")
    req = os.path.join(APP_HOME, "agent", "agent-core-requirements.txt")
    install_with_fallback(pip, ["--require-hashes", "-r", req],
                          [m["pip"]["index_url"], m["pip"]["fallback_index_url"]])
    st.mark("agent_deps")


def ensure_lazy_extras(m: dict, st: State) -> None:
    """Pre-install the agent's runtime lazy-install extras (tts.edge etc.).

    The agent's tool registry lazily pip-installs optional feature deps on
    first use; on a slow network that stalls the first chat turn by minutes
    (user-observed: 98s for edge-tts). Pre-installing the hashed union lock
    (agent-core + extras, versions unified) removes the stall. Non-fatal:
    TTS is optional, the agent falls back to lazy install at runtime."""
    mark = "lazy_extras"
    if st.done(mark):
        return
    pip = os.path.join(STATE, "venvs", "app", "bin", "pip")
    req = os.path.join(APP_HOME, "agent", "lazy-extras.lock")
    if not os.path.exists(req):
        log("lazy-extras lock missing, skipping (runtime lazy install remains)")
        st.mark(mark)
        return
    log("installing lazy extras: edge-tts (hashed) ...")
    try:
        install_with_fallback(pip, ["--require-hashes", "-r", req],
                              [m["pip"]["index_url"], m["pip"]["fallback_index_url"]])
        st.mark(mark)
    except BootError as e:
        log(f"WARNING: lazy extras install failed (optional; will retry next "
            f"start, runtime lazy install remains): {e}")


def ensure_agent_editable(m: dict, agent_dir: str, st: State) -> None:
    if st.done("agent_editable"):
        return
    pip = os.path.join(STATE, "venvs", "app", "bin", "pip")
    log("installing hermes-agent (editable) ...")
    # hermes-agent's setup.py refuses regular wheel/sdist builds by design
    # (upstream distributes via installer/Docker/Nix); editable install is
    # the supported path and keeps the unpacked source tree authoritative.
    # Build isolation needs setuptools+wheel from an index, so the index
    # (with fallback) is passed here too.
    install_with_fallback(pip, ["--no-deps", "--editable", agent_dir],
                          [m["pip"]["index_url"], m["pip"]["fallback_index_url"]])
    st.mark("agent_editable")


def check(m: dict, st: State) -> bool:
    ok = (
        st.done("runtime")
        and os.path.exists(os.path.join(STATE, m["runtime"]["dest"], "bin", "python3"))
        and st.done("app_venv")
        and os.path.exists(os.path.join(STATE, "venvs", "app", "bin", "python3"))
        and st.done("agent_src")
        and os.path.isdir(os.path.join(STATE, m["agent"]["dest"]))
        and st.done("agent_deps")
        and st.done("lazy_extras")
        and st.done("agent_editable")
    )
    return ok


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true",
                    help="exit 0 only if every component is provisioned")
    args = ap.parse_args()
    try:
        m = load_manifest()
        st = State(os.path.join(STATE, "bootstrap", "state.json"))
        if args.check:
            return 0 if check(m, st) else 1
        downloads = os.path.join(STATE, "downloads")
        os.makedirs(downloads, exist_ok=True)
        rt_python = ensure_runtime(m, st, downloads)
        ensure_app_venv(rt_python, st)
        agent_dir = ensure_agent(m, st, downloads)
        ensure_agent_deps(m, st)
        ensure_lazy_extras(m, st)
        ensure_agent_editable(m, agent_dir, st)
        log("all components provisioned")
        return 0
    except BootError as e:
        log(str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main())
