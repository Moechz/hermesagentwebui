#!/bin/bash
# hermesagent service package lifecycle: post-remove. No network operations
# (official review red line, docs/official/review-standards §Security).
#
# Data policy: on "remove" all user data under /var/lib/hermesagent/hermes
# (chat sessions, agent memory, credentials) is KEPT so reinstallation or
# upgrade never loses it. Only "purge" deletes application state.
set -e

case "${1:-}" in
  remove|purge)
    rm -f /etc/systemd/system/hermesagent.service
    rm -f /etc/nginx/conf.d/hermesagent.conf
    # Removing the route must not leave nginx unable to reload.
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
      nginx -s reload >/dev/null 2>&1 || true
    fi
    ;;
esac
systemctl daemon-reload

if [ "${1:-}" = "purge" ]; then
  rm -rf /var/lib/hermesagent
  rm -rf /var/log/hermesagent
fi

exit 0
