#!/bin/bash
# hermeswebui service package lifecycle: install.
# Official red line (docs/official/review-standards §Security): lifecycle
# scripts must NOT perform network operations (no apt/pip install, no
# curl|bash). Component fetching happens at first service start (D-007).
set -e

APP_ID=hermeswebui
APP_HOME=/usr/local/hermeswebui
UNIT_SRC="$APP_HOME/init.d/hermeswebui.service"
UNIT_DST=/etc/systemd/system/hermeswebui.service

# Dedicated non-root system user (official one-vote-veto: never run as root).
if ! getent group "$APP_ID" >/dev/null 2>&1; then
  groupadd --system "$APP_ID"
fi
if ! id "$APP_ID" >/dev/null 2>&1; then
  useradd --system \
    --gid "$APP_ID" \
    --home-dir /var/lib/hermeswebui \
    --no-create-home \
    --shell /usr/sbin/nologin \
    "$APP_ID"
fi

# State and log locations. HERMES_HOME (/var/lib/hermeswebui/hermes) holds
# sessions, agent memory and credentials; it survives upgrades and removal.
mkdir -p /var/lib/hermeswebui/hermes /var/log/hermeswebui
chown "$APP_ID:$APP_ID" /var/lib/hermeswebui /var/lib/hermeswebui/hermes /var/log/hermeswebui
chmod 0711 /var/lib/hermeswebui /var/lib/hermeswebui/hermes
chmod 0750 /var/log/hermeswebui

chmod 0755 "$APP_HOME/bin/hermeswebui"

# TOS App Center expects persistent regular unit files under
# /etc/systemd/system (symlinks into /usr/local can be removed by the
# platform during stop/disable handling — validated Rsync Backup lesson).
if [ -f "$UNIT_SRC" ]; then
  cp "$UNIT_SRC" "$UNIT_DST"
  chown root:root "$UNIT_DST"
  chmod 0644 "$UNIT_DST"
fi
systemctl daemon-reload

# Official lifecycle expectation (docs/official/package-specification):
# postinst sets permissions, enables and starts the service.
systemctl enable hermeswebui.service
systemctl start hermeswebui.service

exit 0
