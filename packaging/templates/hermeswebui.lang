[en-us]
name = "Hermes Agent WebUI"
auth = "Nous Research"
descript = "Hermes Agent WebUI brings the open-source Hermes Agent to your TNAS: chat from any browser with the same capabilities as the command line. Streaming replies, session and workspace browsing, profile switching, and background operation with scheduled tasks. Conversations, memory, and settings stay on your device - nothing is uploaded to third parties. A first-run wizard guides you through setting an access password and connecting your own model provider (API key required). The first launch needs internet access to download runtime components."
release_note = "Initial beta: TOS 7 App Center packaging of hermes-webui. The first start downloads the pinned Python runtime and Hermes Agent components, then opens the onboarding wizard to set an access password and model providers."
important = "The first launch needs internet access to download runtime components. Set an access password during onboarding; conversations and API keys stay on your NAS."

