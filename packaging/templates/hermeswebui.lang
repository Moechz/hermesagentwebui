[zh-cn]
name = "Hermes Agent WebUI"
auth = "Nous Research"
descript = "Hermes Agent WebUI 将开源智能体 Hermes Agent 带到你的 TNAS：用浏览器即可对话，能力与命令行一致。支持流式回复、历史会话与工作区浏览、多配置切换，常驻后台运行，可定时执行任务。对话记录、记忆与设置全部保存在本机，不上传第三方。首次启动向导会引导设置访问密码并接入你自己的模型服务（需自备 API Key）；首次运行需联网下载运行组件。"
release_note = "首个测试版：hermes-webui 的 TOS 7 应用中心封装。首次启动会按锁定清单联网下载 Python 运行时与 Hermes Agent 组件，随后进入引导向导设置访问密码与模型服务商。"
important = "首次启动需要联网下载运行组件。请在引导向导中设置访问密码；对话记录与 API 密钥仅保存在本机。"

[zh-hk]
name = "Hermes Agent WebUI"
auth = "Nous Research"
descript = "Hermes Agent WebUI 將開源智能體 Hermes Agent 帶到你的 TNAS：用瀏覽器即可對話，能力與命令行一致。支援串流回覆、歷史工作階段與工作區瀏覽、多設定檔切換，常駐背景執行，可定時執行任務。對話記錄、記憶與設定全部保存在本機，不上傳第三方。首次啟動精靈會引導設定存取密碼並接入你自己的模型服務（需自備 API Key）；首次執行需連線下載執行元件。"
release_note = "首個測試版：hermes-webui 的 TOS 7 應用中心封裝。首次啟動會按鎖定清單連線下載 Python 執行環境與 Hermes Agent 元件，隨後進入引導精靈設定存取密碼與模型供應商。"
important = "首次啟動需要連線下載執行元件。請在引導精靈中設定存取密碼；對話記錄與 API 金鑰僅保存在本機。"

